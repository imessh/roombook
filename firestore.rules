rules_version = '2';

service cloud.firestore {
  function isSignedIn() {
    return request.auth != null;
  }

  function userDoc() {
    return get(/databases/$(database)/documents/users/$(request.auth.uid));
  }

  function isAdmin() {
    return isSignedIn() && userDoc().exists() && userDoc().data.role == 'admin';
  }

  function isOwner() {
    return isAdmin() && userDoc().data.isOwner == true;
  }

  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.registeredAt is number
        && request.resource.data.isOwner == false;

      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.isOwner == resource.data.isOwner
          && request.resource.data.name is string
          && request.resource.data.email is string)
      );

      allow delete: if isSignedIn() && isAdmin() && resource.data.isOwner != true;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(
          ['roomId', 'roomName', 'name', 'date', 'startTime', 'endTime', 'category', 'createdBy']
        )
        && request.resource.data.startTime < request.resource.data.endTime
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isSignedIn()
        && request.resource.data.startTime < request.resource.data.endTime
        && (
          resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
        )
        || isAdmin();

      allow delete: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
      );
    }
  }
}
